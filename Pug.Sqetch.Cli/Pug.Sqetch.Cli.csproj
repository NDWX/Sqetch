<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>sqetch</AssemblyName>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <!-- also shipped as a framework-dependent dotnet tool -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <PackageId>Pug.Sqetch.Cli</PackageId>
        <ToolCommandName>sqetch</ToolCommandName>
        <Description>Sqetch: author database schema changes as plans, group them into releases and bundle them for deployment.</Description>
        <PackageLicenseExpression>GPL-3.0-or-later AND AGPL-3.0-or-later</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
      <None Include="LICENSE" Pack="true" PackagePath="licenses/GPL-3.0/" />
      <None Include="..\LICENSE" Pack="true" PackagePath="licenses/AGPL-3.0/" />
      <None Include="..\LICENSING.md" Pack="true" PackagePath="" />
      <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    </ItemGroup>

    <Import Project="..\Installers\Publish.props" />

    <ItemGroup>
      <ProjectReference Include="..\Pug.Sqetch.Cli.Commands\Pug.Sqetch.Cli.Commands.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    </ItemGroup>

</Project>
