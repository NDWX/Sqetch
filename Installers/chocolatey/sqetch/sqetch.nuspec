<?xml version="1.0" encoding="utf-8"?>
<!-- Packed by Installers/build/Windows.ps1, which stages this folder, adds the MSI under tools/ and passes
     the real version on the choco pack command line; the version below is only a placeholder. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
	<metadata>
		<id>sqetch</id>
		<version>0.0.0</version>
		<title>Sqetch</title>
		<authors>Pug</authors>
		<owners>Pug</owners>
		<projectUrl>https://github.com/NDWX/Sqetch</projectUrl>
		<projectSourceUrl>https://github.com/NDWX/Sqetch</projectSourceUrl>
		<bugTrackerUrl>https://github.com/NDWX/Sqetch/issues</bugTrackerUrl>
		<licenseUrl>https://github.com/NDWX/Sqetch/blob/main/LICENSING.md</licenseUrl>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<copyright>Pug</copyright>
		<tags>sqetch database schema migration sql cli devops</tags>
		<summary>Sqetch: author database schema changes as plans, group them into releases and bundle them for deployment</summary>
		<description>Sqetch is a DevOps database schema upgrader. A project contains plans (units of schema change), each plan contains steps with three SQL scripts (deploy, verify and rollback), and plans are grouped into releases that form a single linear lineage.

This package installs the `sqetch` command line tool, which authors that project: it creates plans and steps, groups plans into releases, finalizes releases and produces deployment bundles. Bundles are deployed with the companion `sqetch-deploy` tool (package `sqetch-deploy`).

The package embeds the Windows x64 installer (MSI) built and signed by the release pipeline and runs it silently for all users, which puts `sqetch` on the system PATH. A per-user installation (no administrator rights) is available from the MSI attached to each GitHub release.</description>
	</metadata>
</package>
